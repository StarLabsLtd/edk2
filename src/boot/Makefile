	@$(CDK2_NATIVE_HOST_CC) $(CDK2_NATIVE_HOST_CFLAGS) -fsanitize=address,undefined \
		$(CDK2_NATIVE_INCLUDES) -MMD -MP -MF "$(@:.test=.d)" -MT "$@" \
