[Defines]
  INF_VERSION                    = 0x00010017
  BASE_NAME                      = BootKeyDmaIsolationDxe
  FILE_GUID                      = A57975D7-31D8-47A0-B686-F80C0E952B15
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = BootKeyDmaIsolationEntryPoint

[Sources]
  BootKeyDmaIsolationDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  UefiPayloadPkg/UefiPayloadPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  BootKeyIntelClientPlatformLib
  CbMemLib
  DebugLib
  IoLib
  MemoryAllocationLib
  PcdLib
  PciSegmentLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gBootKeyDmaIsolationProtocolGuid             ## PRODUCES
  gEdkiiIoMmuProtocolGuid                      ## PRODUCES
  gEfiPciIoProtocolGuid                        ## CONSUMES

[FixedPcd]
  gUefiPayloadPkgTokenSpaceGuid.PcdBootKeyDmaArenaSize
  gUefiPayloadPkgTokenSpaceGuid.PcdBootKeyDmaIsolationRequired

[Depex]
  TRUE
