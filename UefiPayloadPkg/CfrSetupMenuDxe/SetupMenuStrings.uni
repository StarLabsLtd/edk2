///** @file
//  String definitions for the CFR Setup Menu.
//**/

#langdef   en-US "English"
#langdef   fr-FR "Français"

#string STR_CFR_MENU_TITLE  #language en-US  "Settings"
                            #language fr-FR  "Settings"
#string STR_CFR_MENU_HELP   #language en-US  "Configure system settings"
                            #language fr-FR  "Configure system settings"
#string STR_CFR_MENU_BOOT_SECTION #language en-US "Boot"
                                #language fr-FR "Boot"
#string STR_CFR_MENU_BOOT_TIMEOUT_PROMPT #language en-US "Boot timeout"
                                       #language fr-FR "Boot timeout"
#string STR_CFR_MENU_BOOT_TIMEOUT_HELP #language en-US "Seconds to wait before booting normally. Set 0 to boot immediately. Set 65535 to wait forever."
                                     #language fr-FR "Seconds to wait before booting normally. Set 0 to boot immediately. Set 65535 to wait forever."
#string STR_CFR_MENU_SECURITY_SECTION #language en-US "Security"
                                    #language fr-FR "Security"
#string STR_EMPTY_STRING    #language en-US  ""
                            #language fr-FR  ""
#string STR_INVALID_STRING  #language en-US  "INVALID"
                            #language fr-FR  "INVALID"
