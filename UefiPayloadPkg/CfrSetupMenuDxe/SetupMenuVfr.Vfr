#include <Uefi/UefiMultiPhase.h>
#include <Guid/GlobalVariable.h>
#include <Guid/HiiPlatformSetupFormset.h>
#include "SetupMenuNVDataStruc.h"

formset
  guid      = SETUP_MENU_FORMSET_GUID,
  title     = STRING_TOKEN(STR_CFR_MENU_TITLE),
  help      = STRING_TOKEN(STR_CFR_MENU_HELP),
  classguid = EFI_HII_PLATFORM_SETUP_FORMSET_GUID,

  efivarstore SETUP_MENU_TIMEOUT_CONFIGURATION,
    varid = SETUP_MENU_TIMEOUT_VARSTORE_ID,
    attribute = EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS | EFI_VARIABLE_NON_VOLATILE,
    name  = Timeout,
    guid  = gEfiGlobalVariableGuid;

  form formid = SETUP_MENU_FORM_ID,
    title = STRING_TOKEN(STR_CFR_MENU_TITLE);

    suppressif TRUE;
      text
        help  = STRING_TOKEN(STR_EMPTY_STRING),
        text  = STRING_TOKEN(STR_EMPTY_STRING),
        flags = INTERACTIVE,
        key   = SETUP_MENU_REFRESH_KEY_ID;
    endif;

    /**
      Static sections owned by this DXE

    **/
    subtitle text = STRING_TOKEN(STR_CFR_MENU_BOOT_SECTION);

    numeric varid   = Timeout.BootTimeOut,
            prompt  = STRING_TOKEN(STR_CFR_MENU_BOOT_TIMEOUT_PROMPT),
            help    = STRING_TOKEN(STR_CFR_MENU_BOOT_TIMEOUT_HELP),
            flags   = 0,
            minimum = 0,
            maximum = 65535,
            step    = 1,
    endnumeric;

    subtitle text = STRING_TOKEN(STR_EMPTY_STRING);

    /**
      Sections for runtime components

    **/
    label LABEL_RT_COMP_START;
    label LABEL_RT_COMP_END;

  endform;

endformset;
