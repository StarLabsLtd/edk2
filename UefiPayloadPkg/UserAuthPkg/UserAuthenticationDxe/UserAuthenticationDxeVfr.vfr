#include <Guid/HiiPlatformSetupFormset.h>
#include "UserAuthenticationDxeFormset.h"

formset
  guid      = USER_AUTHENTICATION_FORMSET_GUID,
  title     = STRING_TOKEN(STR_FORM_SET_TITLE),
  help      = STRING_TOKEN(STR_FORM_SET_TITLE_HELP),
  classguid = EFI_HII_PLATFORM_SETUP_FORMSET_GUID,

  form formid = 1,
      title  = STRING_TOKEN(STR_FORM_TITLE);

      suppressif TRUE;
        text
          help  = STRING_TOKEN(STR_EMPTY_STRING),
          text  = STRING_TOKEN(STR_EMPTY_STRING),
          flags = INTERACTIVE,
          key   = USER_PASSWORD_REFRESH_KEY_ID;
      endif;

      grayoutif  TRUE;
        text
          help  = STRING_TOKEN(STR_ADMIN_PASSWORD_STS_HELP),
          text  = STRING_TOKEN(STR_ADMIN_PASSWORD_STS_PROMPT),
          text  = STRING_TOKEN(STR_ADMIN_PASSWORD_STS_CONTENT);
      endif;

      subtitle text = STRING_TOKEN(STR_EMPTY_STRING);

      label LABEL_USER_PASSWORD_ACTIONS_START;
      label LABEL_USER_PASSWORD_ACTIONS_END;

  endform;

endformset;
